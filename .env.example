TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather

# Optional. Whisper model used for Persian voice transcription.
# Defaults to "large-v3-turbo" — the best accuracy/speed balance for Persian.
#
#   small           ~0.5 GB  fastest, but poor Persian accuracy
#   medium          ~1.5 GB  decent Persian, slow on CPU
#   large-v3-turbo  ~1.6 GB  near-best Persian, fast  (default)
#   large-v3        ~3.0 GB  best Persian, slowest
#
# WHISPER_MODEL=large-v3-turbo
